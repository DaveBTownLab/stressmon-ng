
#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WORKDIR="$PWD"

if [[ -x "$SCRIPT_DIR/scripts/stresscpu" ]]; then
    # Running from the Git project
    CPU_SCRIPT="$SCRIPT_DIR/scripts/stresscpu"
    MONITOR_SCRIPT="$SCRIPT_DIR/scripts/stressmon"
else
    # Installed version
    CPU_SCRIPT="stresscpu"
    MONITOR_SCRIPT="stressmon"
fi

DURATION=${1:-60}

# Detect terminal emulator

if command -v konsole >/dev/null 2>&1; then
    TERMINAL="konsole"
elif command -v xfce4-terminal >/dev/null 2>&1; then
    TERMINAL="xfce4-terminal"
elif command -v gnome-terminal >/dev/null 2>&1; then
    TERMINAL="gnome-terminal"
elif command -v xterm >/dev/null 2>&1; then
    TERMINAL="xterm"
else
    echo "No supported terminal emulator found."
    exit 1
fi

echo "Using terminal: $TERMINAL"

# Start CPU stress test in background

"$CPU_SCRIPT" "$DURATION" >/dev/null 2>&1 &
STRESS_PID=$!

# Cleanup

cleanup() {
    if kill -0 "$STRESS_PID" 2>/dev/null; then
        kill "$STRESS_PID"
        wait "$STRESS_PID" 2>/dev/null
    fi
}

trap cleanup EXIT INT TERM

sleep 0.5

# Start monitor

case "$TERMINAL" in
    konsole)
        konsole \
            --title="Stress Monitor" \
            --workdir="$WORKDIR" \
            -e "$MONITOR_SCRIPT" "$DURATION" &
        ;;

    xfce4-terminal)
        xfce4-terminal \
            --title="Stress Monitor" \
            --working-directory="$WORKDIR" \
            -e "$MONITOR_SCRIPT $DURATION" &
        ;;

    gnome-terminal)
        gnome-terminal \
            --title="Stress Monitor" \
            --working-directory="$WORKDIR" \
            -- "$MONITOR_SCRIPT" "$DURATION" &
        ;;

    xterm)
        xterm \
            -T "Stress Monitor" \
            -e "$MONITOR_SCRIPT" "$DURATION" &
        ;;
esac

# Wait for monitor to exit

MONITOR_PID=$!
wait "$MONITOR_PID"

# Cleanup will be called automatically by trap
